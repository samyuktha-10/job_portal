# ── Django ──────────────────────────────────────────────────────────────
SECRET_KEY=your-strong-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Base URL used to build absolute links (emails, DigiLocker redirects).
SITE_URL=http://127.0.0.1:8000

# ── Production security (leave defaults; override on the host) ─────────
# SECURE_SSL_REDIRECT=False
# SESSION_COOKIE_SECURE=<auto: True when DEBUG=False>
# CSRF_COOKIE_SECURE=<auto: True when DEBUG=False>
# SECURE_HSTS_SECONDS=<auto: 31536000 when DEBUG=False>
# CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com

# ── Database (Render/Railway provide DATABASE_URL automatically) ───────
# If DATABASE_URL is empty, these PostgreSQL settings are used instead:
DATABASE_URL=
DB_NAME=job_portal
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# ── Email ───────────────────────────────────────────────────────────────
# SMTP is used automatically when both user + password are set; otherwise
# emails print to the console (dev). Full backend path can override EMAIL_BACKEND.
EMAIL_HOST_USER=you@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# ── File storage (S3) ───────────────────────────────────────────────────
# User uploads (resumes, logos, BGV documents) go to S3 when these are set.
# Leave blank to use local media/ for development.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
# AWS_S3_ENDPOINT_URL=   # optional: Cloudflare R2 / MinIO
# AWS_S3_CUSTOM_DOMAIN=  # optional CDN domain

# ── Razorpay (payments) ─────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── WhatsApp Business API (job alerts) ──────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v25.0
WHATSAPP_VERIFY_TOKEN=

# ── Background verification (DigiLocker) ──────────────────────────────
# Register at dashboard.digilocker.gov.in to get real credentials.
# With these set (and DIGILOCKER_DEMO_MODE=False) the app uses the real
# OAuth2 flow against api.digilocker.gov.in. Without them it runs the
# built-in demo simulator (no credentials needed).
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_DEMO_MODE=True
